{
	"compilerOptions": {
		"target": "es2022",
		"lib": ["es2023", "dom", "dom.iterable"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"types": ["vite/client"]
	},
	"include": ["src", "vite.config.ts", "../src/types.ts", "../src/gate-plan.ts"]
}
