{
	"compilerOptions": {
		"target": "es2024",
		"lib": ["es2024"],
		"module": "es2022",
		"moduleResolution": "bundler",
		"types": ["./worker-configuration.d.ts"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noEmit": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		// The dashboard's own alias, for components the shadcn CLI adds (components.json): @/components/ui/...
		"paths": { "@/*": ["./web/src/*"] }
	},
	"include": ["src", "test", "app", "worker-configuration.d.ts"]
}
