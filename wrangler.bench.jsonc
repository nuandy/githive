// The benchmark deployment: the same Worker under another name, so load tests never
// touch real repos or the dashboard. Fake agents don't need containers,
// and the event queue can only have one consumer, so both are left out.
// Deploy: npm run build:web && npx wrangler deploy -c wrangler.bench.jsonc
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "blueprint-bench",
	"main": "src/index.ts",
	// The Access hostname (blueprint-bench.nuandy.workers.dev) for admins and scripts, and the public one for sign-in and OAuth.
	"workers_dev": true,
	"routes": [{ "pattern": "bench.githive.app", "custom_domain": true }],
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },
	"preview_urls": false,
	"vars": {
		// Where people sign in and MCP clients connect over OAuth (no Access in front). The Access hostnames serve as before.
		"PUBLIC_ORIGIN": "https://bench.githive.app",
		"ACCESS_TEAM_DOMAIN": "little-cake-3c64.cloudflareaccess.com",
		"ACCESS_AUD": "40a0a047944251bc67f3291f138b617f8cdb68f342635bd15582a6d770d1fd52",
		// Bench only: POST /admin/wipe may delete every repo in this namespace. Never set on production.
		"BENCH_WIPE": "allowed"
	},
	"assets": {
		"directory": "./web/dist",
		"binding": "ASSETS",
		"run_worker_first": true,
		"not_found_handling": "single-page-application"
	},
	// Its own namespace, so benchmark repos and forks never show up beside real projects.
	"artifacts": [{ "binding": "ARTIFACTS", "namespace": "blueprint-bench", "remote": true }],
	"durable_objects": {
		"bindings": [
			{ "name": "BUILDER", "class_name": "Builder" },
			{ "name": "REVIEWER", "class_name": "Reviewer" },
			{ "name": "GATE", "class_name": "Gate" },
			{ "name": "REPO_INDEX", "class_name": "RepoIndex" },
			{ "name": "REPO_CACHE", "class_name": "RepoCache" },
			{ "name": "TOKENS", "class_name": "TokenCache" }
		]
	},
	// GitHive's own identity: people, sessions, agents and their tokens (migrations/).
	"d1_databases": [{ "binding": "DB", "database_name": "githive-bench", "database_id": "72e60aef-4f1f-48da-93e4-cc1811443db7", "migrations_dir": "migrations" }],
	// The OAuth provider's grants and tokens, for MCP clients that sign in.
	"kv_namespaces": [{ "binding": "OAUTH_KV", "id": "adf3d5a6fa5247f6849af337c4236193" }],
	"containers": [
		{ "class_name": "Gate", "scheduling_policy": "durable_object" },
		{ "class_name": "Reviewer", "scheduling_policy": "durable_object" },
		{ "class_name": "Builder", "scheduling_policy": "durable_object" }
	],
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["Coordinator"] },
		{ "tag": "v2", "new_sqlite_classes": ["Builder"] },
		{ "tag": "v3", "new_sqlite_classes": ["Reviewer"] },
		{ "tag": "v4", "new_sqlite_classes": ["Gate"] },
		{ "tag": "v5", "new_sqlite_classes": ["TaskIndex"] },
		{ "tag": "v6", "new_sqlite_classes": ["ContractChecker"] },
		{ "tag": "v7", "new_sqlite_classes": ["Peer"] },
		// Planned mode (contracts) is gone; it lives on the plan-mode branch.
		{ "tag": "v8", "deleted_classes": ["ContractChecker"] },
		// The dashboard's live updates.
		{ "tag": "v9", "new_sqlite_classes": ["LiveFeed"] },
		{ "tag": "v10", "new_sqlite_classes": ["TokenCache"] },
		// Elected mode is frozen (branch elected-mode-archive); its task state goes.
		{ "tag": "v11", "deleted_classes": ["Coordinator", "Peer"] },
		// GitHive: the repo index starts fresh under its new name.
		{ "tag": "v12", "deleted_classes": ["TaskIndex"], "new_sqlite_classes": ["RepoIndex"] },
		// The repo's live feed became its cache, too (views, record tips, the fork queue, landing): the same objects and storage, renamed.
		{ "tag": "v13", "renamed_classes": [{ "from": "LiveFeed", "to": "RepoCache" }] }
	]
}
