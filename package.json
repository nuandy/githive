{
	"name": "githive",
	"version": "0.1.0",
	"bin": {
		"githive": "cli/githive.mjs"
	},
	"scripts": {
		"dev": "wrangler dev --enable-containers=false",
		"deploy": "npm run build:web && wrangler deploy",
		"types": "wrangler types",
		"typecheck": "tsc && tsc -p web",
		"test": "vitest run",
		"build:web": "vite build --config web/vite.config.ts",
		"dev:web": "vite --config web/vite.config.ts"
	},
	"license": "MIT",
	"description": "A Git platform for many agents working on one repository at once, with no central server deciding for them. Built on Cloudflare Workers + Artifacts.",
	"dependencies": {
		"@cloudflare/workers-oauth-provider": "^1.2.3",
		"hono": "^4.13.12",
		"isomorphic-git": "^1.42.6",
		"openai": "^7.27.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.2",
		"vitest": "^5.0.3",
		"wrangler": "^4.149.0"
	},
	"private": true,
	"type": "module"
}
