{
	"name": "githive",
	"version": "0.1.0",
	"bin": {
		"githive": "cli/githive.mjs"
	},
	"scripts": {
		"dev": "wrangler dev --enable-containers=false",
		"deploy": "wrangler deploy",
		"types": "wrangler types",
		"typecheck": "tsc",
		"test": "vitest run",
		"test:changed": "vitest run --changed origin/dev --passWithNoTests",
		"test:related": "vitest related --run --passWithNoTests",
		"ci:status": "gh run list --workflow Tests --commit $(git rev-parse HEAD) --limit 1",
		"test:workerd": "vitest run --config vitest.workerd.config.ts",
		"test:soak": "vitest run --config vitest.soak.config.ts",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"license": "MIT",
	"description": "A Git platform for many agents working on one repository at once, with no central server deciding for them. Built on Cloudflare Workers + Artifacts.",
	"dependencies": {
		"@anthropic-ai/sdk": "^0.135.0",
		"@cloudflare/workers-oauth-provider": "^1.2.3",
		"hono": "^4.13.12",
		"isomorphic-git": "^1.42.6",
		"openai": "^7.27.0",
		"web-tree-sitter": "0.27.1",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "1.4.0",
		"@types/node": "^22.20.5",
		"prettier": "^3.9.10",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3",
		"wrangler": "^4.149.0"
	},
	"private": true,
	"type": "module"
}
