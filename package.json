{
	"name": "githive",
	"version": "0.1.0",
	"bin": {
		"githive": "cli/githive.mjs"
	},
	"scripts": {
		"dev": "wrangler dev --enable-containers=false",
		"deploy": "npm run build:web && wrangler deploy",
		"types": "wrangler types",
		"typecheck": "tsc && tsc -p web && tsc -p web/visual",
		"test": "vitest run",
		"test:workerd": "vitest run --config vitest.workerd.config.ts",
		"test:soak": "vitest run --config vitest.soak.config.ts",
		"build:web": "vite build --config web/vite.config.ts",
		"dev:web": "vite --config web/vite.config.ts",
		"dev:web:fixtures": "GITHIVE_API=fixtures vite --config web/vite.config.ts",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"visual": "node web/visual/capture.ts",
		"visual:compare": "node web/visual/compare.ts"
	},
	"license": "MIT",
	"description": "A Git platform for many agents working on one repository at once, with no central server deciding for them. Built on Cloudflare Workers + Artifacts.",
	"dependencies": {
		"@cloudflare/workers-oauth-provider": "^1.2.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"hono": "^4.13.12",
		"isomorphic-git": "^1.42.6",
		"openai": "^7.27.0",
		"radix-ui": "^1.8.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"tailwind-merge": "^3.7.0",
		"web-tree-sitter": "0.27.1",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "1.4.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^22.20.5",
		"@types/pngjs": "^6.0.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"pixelmatch": "^8.0.0",
		"playwright-core": "^1.64.0",
		"pngjs": "^7.0.0",
		"prettier": "^3.9.10",
		"puppeteer-core": "^25.13.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.2",
		"vitest": "^5.0.3",
		"wrangler": "^4.149.0"
	},
	"private": true,
	"type": "module"
}
