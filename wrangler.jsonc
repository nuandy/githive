{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// GitHive. The Worker and its Artifacts namespace keep their first name, "blueprint":
	// renaming the namespace would start it empty, and the Worker's URL stays the same.
	"name": "blueprint",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },
	// The most CPU one invocation may use: twice the 30 s default, sized for the push consumer's awareness work, which
	// parses in this Worker (src/push-events.ts). A batch's budget (4 million characters, 200 parses) is a few seconds
	// of parsing even on CPUs slower than the laptop it was measured on, so a full batch stays well under this, with
	// room for its reads and tree walks. An invocation over it is killed whole: the heads were acked first, so only
	// that batch's hints are lost. Agents' calls and the dashboard use far less, and ran under the default.
	"limits": { "cpu_ms": 60000 },
	"workers_dev": true,
	// githive.app: people sign in and MCP clients connect (no Access in front). blueprint.nuandy.workers.dev stays the Access door for admins and scripts.
	"routes": [{ "pattern": "githive.app", "custom_domain": true }],
	"vars": {
		// Where people sign in and MCP clients connect over OAuth (no Access in front). The Access hostnames serve as before.
		"PUBLIC_ORIGIN": "https://githive.app",
		"ACCESS_TEAM_DOMAIN": "little-cake-3c64.cloudflareaccess.com",
		"ACCESS_AUD": "40a0a047944251bc67f3291f138b617f8cdb68f342635bd15582a6d770d1fd52",
		// The Artifacts namespace below, by name: push events come from every namespace in the account, and only its own count.
		"ARTIFACTS_NAMESPACE": "blueprint",
		// The one public repo demo runs build Honeycomb in (src/demo/demo-repo.ts); the first run makes it.
		"DEMO_REPO": "nuandy/honeycomb",
	},
	// The dashboard (web/, built with `npm run build:web`). The Worker runs first
	// so API routes win; anything else falls through to these files.
	"assets": {
		"directory": "./web/dist",
		"binding": "ASSETS",
		"run_worker_first": true,
		"not_found_handling": "single-page-application",
	},
	"preview_urls": false,
	"artifacts": [
		{
			"binding": "ARTIFACTS",
			"namespace": "blueprint",
			// Artifacts has no local emulator; dev talks to the real service.
			"remote": true,
		},
	],
	"durable_objects": {
		"bindings": [
			{ "name": "BUILDER", "class_name": "Builder" },
			{ "name": "REVIEWER", "class_name": "Reviewer" },
			{ "name": "GATE", "class_name": "Gate" },
			{ "name": "REPO_INDEX", "class_name": "RepoIndex" },
			{ "name": "REPO_CACHE", "class_name": "RepoCache" },
			{ "name": "RECORD_CACHE", "class_name": "RecordCache" },
			{ "name": "CHANGE_CACHE", "class_name": "ChangeCache" },
			{ "name": "TOKENS", "class_name": "TokenCache" },
			{ "name": "FOOTPRINT_CACHE", "class_name": "FootprintCache" },
			{ "name": "GITHUB_SYNC", "class_name": "GitHubSync" },
			{ "name": "DEMO_RUN", "class_name": "DemoRun" },
			{ "name": "HOSTED_AGENT", "class_name": "HostedAgent" },
		],
	},
	// One container per builder or reviewer agent, and per integration gate run. The image (cloudflare/debian-trixie)
	// is chosen at start(), so no Dockerfile or local Docker is needed to deploy.
	// GitHive's own identity: people, sessions, agents and their tokens (migrations/).
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "githive",
			"database_id": "d443038b-ea5c-40e5-9a5f-86adefdbc667",
			"migrations_dir": "migrations",
		},
	],
	// The OAuth provider's grants and tokens, for MCP clients that sign in.
	// Clef, Cloudflare's decision models, for hints on what agents write (see src/clef.ts).
	"ai": { "binding": "AI" },
	"kv_namespaces": [{ "binding": "OAUTH_KV", "id": "9449f5dfdc074c228358d0bbcd85abf0" }],
	// Every push in the account, from one account-wide subscription (see src/push-events.ts):
	//   wrangler queues create githive-pushes
	//   wrangler queues subscription create githive-pushes --source artifacts --events repo.pushed
	// A queue has one consumer, so production and the bench each have their own.
	"queues": {
		"consumers": [{ "queue": "githive-pushes", "max_batch_size": 100, "max_batch_timeout": 2, "max_retries": 3 }],
	},
	"containers": [
		{ "class_name": "Builder", "scheduling_policy": "durable_object" },
		{ "class_name": "Reviewer", "scheduling_policy": "durable_object" },
		{ "class_name": "Gate", "scheduling_policy": "durable_object" },
	],
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["Coordinator"] },
		{ "tag": "v2", "new_sqlite_classes": ["Builder"] },
		{ "tag": "v3", "new_sqlite_classes": ["Reviewer"] },
		{ "tag": "v4", "new_sqlite_classes": ["Gate"] },
		{ "tag": "v5", "new_sqlite_classes": ["TaskIndex"] },
		{ "tag": "v6", "new_sqlite_classes": ["ContractChecker"] },
		{ "tag": "v7", "new_sqlite_classes": ["Peer"] },
		// Planned mode (contracts) is gone; 926c4b2 is the last version with it.
		{ "tag": "v8", "deleted_classes": ["ContractChecker"] },
		// The dashboard's live updates.
		{ "tag": "v9", "new_sqlite_classes": ["LiveFeed"] },
		{ "tag": "v10", "new_sqlite_classes": ["TokenCache"] },
		// Elected mode is frozen (tag elected-mode-final); its task state goes.
		{ "tag": "v11", "deleted_classes": ["Coordinator", "Peer"] },
		// GitHive: the repo index starts fresh under its new name.
		{ "tag": "v12", "deleted_classes": ["TaskIndex"], "new_sqlite_classes": ["RepoIndex"] },
		// The repo's live feed became its cache, too (views, record tips, the fork queue, landing): the same objects and storage, renamed.
		{ "tag": "v13", "renamed_classes": [{ "from": "LiveFeed", "to": "RepoCache" }] },
		// Record tips and states, and what merges keep for their landing, moved out of RepoCache into objects of their own.
		{ "tag": "v14", "new_sqlite_classes": ["RecordCache", "ChangeCache"] },
		// Awareness: parsed files, open changes' footprints and told notices, per repo (docs/awareness.md).
		{ "tag": "v15", "new_sqlite_classes": ["FootprintCache"] },
		// A connected repo's GitHub side: the job bringing GitHub's changes back, and the pull request as last seen.
		{ "tag": "v16", "new_sqlite_classes": ["GitHubSync"] },
		// Honeycomb demo runs: the registry that caps them, and one per run driving its workers (src/demo/).
		{ "tag": "v17", "new_sqlite_classes": ["DemoRun", "HostedAgent"] },
	],
}
